# Synod
.synod-attachments/
.synod-worktrees/

# Build
build/
build-*/
cmake-build-*/
out/
bin/
obj/

# CMake — generated files (never commit)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json
# NOTE: *.cmake is intentionally NOT ignored — hand-written .cmake modules are
# project sources (find modules, toolchain files). CMake's generated files are
# ignored explicitly above.

# IDE
.vscode/
.idea/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.opendb
*.opensdf
*.sdf
*.suo

# Compiled objects
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.exp
*.pdb
*.ilk

# Logs
*.log
*.log.*

# Cache
.ccache/
*.cache

# Temporary files
*~
*.tmp
*.temp
.DS_Store
Thumbs.db

# Steamworks SDK contents (large, not in repo) — keep the directory placeholder tracked
dev-env/steamworks-sdk/*
!dev-env/steamworks-sdk/.gitkeep

# Test outputs
Testing/
test-results/
coverage/
*.gcda
*.gcno
*.gcov

# Container
# .containerignore is a project deliverable (bounds the container build context) — must stay tracked.
!.containerignore